# TASK 4: Custom Snort Intrusion Detection Rules
# Format: action protocol src_ip src_port -> dst_ip dst_port (options)

# 1. Detect ICMP Ping Floods (Potential DoS attack)
alert icmp any any -> $HOME_NET any (msg:"POTENTIAL DoS - ICMP Ping Flood Detected"; threshold:type both, track by_src, count 50, seconds 10; sid:1000001; rev:1;)

# 2. Detect FTP Anonymous Login Attempts
alert tcp any any -> $HOME_NET 21 (msg:"SUSPICIOUS - FTP Anonymous Login Attempt"; content:"USER anonymous"; nocase; sid:1000002; rev:1;)

# 3. Detect SSH Brute Force Attempts (More than 5 connections in 60 seconds)
alert tcp any any -> $HOME_NET 22 (msg:"WARNING - SSH Brute Force Attempt"; flags:S; threshold:type both, track by_src, count 5, seconds 60; sid:1000003; rev:1;)

# 4. Detect Nmap TCP SYN Scans (Reconnaissance)
alert tcp any any -> $HOME_NET any (msg:"RECON - Nmap TCP SYN Scan Detected"; flags:S; window:1024; sid:1000004; rev:1;)